# API Keys - Required for LLM providers
# Get your keys from the respective provider dashboards

# Zhipu/Zai API Key (https://api.z.ai)
ZAI_API_KEY=your_zhipu_api_key_here

# Ollama API Key (for remote Ollama server)
OLLAMA_API_KEY=your_ollama_api_key_here

# SarvamAI API Key (for speech-to-text and text-to-speech)
# Get from: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenAI API Key (optional, for fallback or direct use)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key (optional, for Gemini models)
# Get from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here
